{
  "name": "learning-hub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "validate:content": "node scripts/validate-content.mjs",
    "check:public-content": "node scripts/check-public-content.mjs",
    "check": "astro check",
    "lint": "eslint scripts/**/*.mjs",
    "test": "vitest run",
    "build": "astro build && pagefind --site dist",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "new:article": "node scripts/new-article.mjs",
    "check:external-links": "node scripts/check-external-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vue": "^7.1.6",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^7.4.12",
    "katex": "0.18.2",
    "mermaid": "^11.12.2",
    "pagefind": "^1.4.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "katex": "$katex"
  }
}
