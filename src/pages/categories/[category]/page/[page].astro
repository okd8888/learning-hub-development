---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArticleExplorer from '../../../../components/cards/ArticleExplorer.vue';
import taxonomy from '../../../../config/taxonomy.json';
import {getPublishedArticles,getReadingMinutes,sortArticles} from '../../../../lib/content';
const pageSize=12;const all=sortArticles(await getPublishedArticles());
export async function getStaticPaths(){const articles=sortArticles(await getPublishedArticles());return taxonomy.categories.flatMap(category=>{const count=Math.ceil(articles.filter(a=>a.data.category===category.id).length/12);return Array.from({length:Math.max(0,count-1)},(_,index)=>({params:{category:category.id,page:String(index+2)},props:{category,page:index+2,count}}));})}
const {category,page,count}=Astro.props;const matches=all.filter(a=>a.data.category===category.id);const items=matches.map(({data,body})=>({stableId:data.stableId,slug:data.slug,title:data.title,description:data.description,category:data.category,type:data.type,tags:data.tags,publishedAt:data.publishedAt,updatedAt:data.updatedAt,readingMinutes:getReadingMinutes(body??''),featured:data.featured}));
---
<BaseLayout title={`${category.label}・第 ${page} 頁`}><main id="main" class="content-page" data-pagefind-ignore><a href={`${import.meta.env.BASE_URL}categories/${category.id}/`}>← {category.label}</a><h1>{category.label}</h1><p>第 {page} 頁，共 {count} 頁。</p><ArticleExplorer client:load items={items} base={import.meta.env.BASE_URL} pageSize={pageSize} initialPage={page}/><nav class="pagination" aria-label="文章分頁"><a href={page===2?`${import.meta.env.BASE_URL}categories/${category.id}/`:`${import.meta.env.BASE_URL}categories/${category.id}/page/${page-1}/`}>上一頁</a><span aria-current="page">{page}</span>{page < count ? <a href={`${import.meta.env.BASE_URL}categories/${category.id}/page/${page+1}/`}>下一頁</a> : null}</nav></main></BaseLayout>
