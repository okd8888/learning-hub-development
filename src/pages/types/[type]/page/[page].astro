---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArticleExplorer from '../../../../components/cards/ArticleExplorer.vue';
import taxonomy from '../../../../config/taxonomy.json';
import {getPublishedArticles,getReadingMinutes,sortArticles} from '../../../../lib/content';
const labels:Record<string,string>={tutorial:'教學',note:'筆記',review:'評估',project:'實作',resource:'資源',reference:'參考',reflection:'心得'};
const all=sortArticles(await getPublishedArticles());
export async function getStaticPaths() {
  const articles=sortArticles(await getPublishedArticles());
  return taxonomy.types.flatMap((type) => {
    const count=Math.ceil(articles.filter(article=>article.data.type===type).length/12);
    return Array.from({length:Math.max(0,count-1)},(_,index) => ({params:{type,page:String(index+2)},props:{type,page:index+2,count}}));
  });
}
const {type,page,count}=Astro.props;
const matches=all.filter(article=>article.data.type===type);
const items=matches.map(({data,body}) => ({stableId:data.stableId,slug:data.slug,title:data.title,description:data.description,category:data.category,type:data.type,tags:data.tags,publishedAt:data.publishedAt,updatedAt:data.updatedAt,readingMinutes:getReadingMinutes(body??''),featured:data.featured}));
---
<BaseLayout title={`${labels[type]}・第 ${page} 頁`}><main id="main" class="content-page" data-pagefind-ignore><a href={`${import.meta.env.BASE_URL}types/${type}/`}>← {labels[type]}</a><span class="eyebrow">內容類型</span><h1>{labels[type]}</h1><p>第 {page} 頁，共 {count} 頁。</p><ArticleExplorer client:load items={items} base={import.meta.env.BASE_URL} initialPage={page} /><nav class="pagination" aria-label="文章分頁"><a href={page===2?`${import.meta.env.BASE_URL}types/${type}/`:`${import.meta.env.BASE_URL}types/${type}/page/${page-1}/`}>上一頁</a><span aria-current="page">{page}</span>{page < count ? <a href={`${import.meta.env.BASE_URL}types/${type}/page/${page+1}/`}>下一頁</a> : null}</nav></main></BaseLayout>
