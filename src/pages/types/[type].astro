---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleExplorer from '../../components/cards/ArticleExplorer.vue';
import taxonomy from '../../config/taxonomy.json';
import {getPublishedArticles,getReadingMinutes,sortArticles} from '../../lib/content';
const labels:Record<string,string>={tutorial:'教學',note:'筆記',review:'評估',project:'實作',resource:'資源',reference:'參考',reflection:'心得'};
export async function getStaticPaths(){return taxonomy.types.map(type=>({params:{type},props:{type}}))}
const {type}=Astro.props;const articles=sortArticles(await getPublishedArticles()).filter(a=>a.data.type===type);const items=articles.map(({data,body})=>({stableId:data.stableId,slug:data.slug,title:data.title,description:data.description,category:data.category,type:data.type,tags:data.tags,publishedAt:data.publishedAt,updatedAt:data.updatedAt,readingMinutes:getReadingMinutes(body??''),featured:data.featured}));
const pageCount=Math.ceil(articles.length/12);
---
<BaseLayout title={labels[type]}><main id="main" class="content-page"><span class="eyebrow">內容類型</span><h1>{labels[type]}</h1><ArticleExplorer client:load items={items} base={import.meta.env.BASE_URL} initialType={type}/><nav class="pagination" aria-label="文章分頁"><span aria-current="page">1</span>{pageCount>1?<a href={`${import.meta.env.BASE_URL}types/${type}/page/2/`}>下一頁</a>:null}</nav></main></BaseLayout>
