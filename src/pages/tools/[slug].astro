---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolHost from '../../components/tools/ToolHost.vue';
import tools from '../../config/tools';
export async function getStaticPaths(){return tools.filter(tool=>tool.enabled).map(tool=>({params:{slug:tool.slug},props:{tool}}))}
const {tool}=Astro.props;
---
<BaseLayout title={tool.title}><main id="main" class="content-page"><a href={`${import.meta.env.BASE_URL}tools/`}>← 工具實驗室</a><span class="eyebrow">本機處理</span><h1>{tool.title}</h1><p class="lead">{tool.description}</p><ToolHost client:visible tool={tool.componentKey}/></main></BaseLayout>
