---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategorySidebar from '../components/navigation/CategorySidebar.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import { getPublishedArticles, getTaxonomyCounts, sortArticles } from '../lib/content';
import { withBase } from '../lib/urls';
import taxonomy from '../config/taxonomy.json';
const articles = sortArticles(await getPublishedArticles());
const featured = [...articles].filter((article) => article.data.featured).sort((a,b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999)).slice(0,3);
const latest = articles.slice(0,6);
const counts = getTaxonomyCounts(articles);
---
<BaseLayout>
  <main id="main" data-pagefind-ignore>
    <section class="hero-section">
      <div class="hero-copy"><span class="eyebrow">一個持續長大的學習空間</span><h1 class="hero-title">把好奇心，<em>寫成自己的知識。</em></h1><p>以 Markdown 記錄學習、以分類連結想法。從一篇筆記開始，逐步建立可搜尋、可分享的知識庫。</p><div class="hero-actions"><a class="button-primary" href={withBase('/articles/')}>探索所有文章</a><a class="button-secondary" href={withBase('/paths/')}>沿著學習路徑前進</a></div></div>
      <div class="hero-visual" aria-hidden="true"><div class="hero-orbit"><span class="brand-mark">L</span></div><div class="hero-note"><b>Knowledge grows here.</b><span>整理、連結、再回來。</span></div></div>
    </section>
    <div class="portal-layout">
      <CategorySidebar counts={counts} />
      <div>
        <section class="section-block" style="padding-top:0">
          <div class="section-header"><div><span class="eyebrow">從這裡開始</span><h2>主題分類</h2><p>依興趣瀏覽不同領域的學習紀錄。</p></div><a class="text-link" href={withBase('/categories/')}>所有分類 →</a></div>
          <div class="category-tiles">{taxonomy.categories.map((category) => <a class="category-tile" href={withBase(`/categories/${category.id}/`)}><span>{category.label}</span><small>{counts[category.id] ?? 0} 篇</small></a>)}</div>
        </section>
        {featured.length > 0 && <section class="section-block"><div class="section-header"><div><span class="eyebrow">編輯精選</span><h2>值得深入的主題</h2></div></div><div class="article-grid">{featured.map((article,index) => <ArticleCard article={article} index={index} />)}</div></section>}
        <section class="section-block"><div class="section-header"><div><span class="eyebrow">持續更新</span><h2>最新學習筆記</h2><p>最近整理與更新的內容。</p></div><a class="text-link" href={withBase('/articles/')}>查看全部 →</a></div>{latest.length ? <div class="article-grid">{latest.map((article,index) => <ArticleCard article={article} index={index} />)}</div> : <div class="empty-state">文章正在整理中，稍後再來看看。</div>}</section>
      </div>
    </div>
  </main>
</BaseLayout>
